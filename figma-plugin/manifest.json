{
  "name": "Figma Token Bridge",
  "id": "figma-token-bridge-rocketscience",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma"],
  "documentAccess": "dynamic-page",
  "permissions": ["currentuser"],
  "enablePrivatePluginApi": true,
  "menu": [
    { "name": "Open Token Bridge", "command": "open" },
    { "name": "Publish all links to Unreal", "command": "publish-all" }
  ],
  "relaunchButtons": [
    { "command": "publish-all", "name": "Publish tokens to Unreal" },
    { "command": "open", "name": "Open Token Bridge" }
  ],
  "networkAccess": {
    "allowedDomains": ["none"],
    "reasoning": "The plugin never sends data anywhere. Publishing stores tokens inside this Figma file's shared plugin data, and Unreal reads them with Figma's own REST API."
  }
}
